# Ket noi MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xianglingo

# Bao mat JWT (JWT_SECRET_KEY va AUTH_EMAIL_HMAC_KEY dai toi thieu 32 byte)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_EMAIL_HMAC_KEY=

# Frontend va gioi han xac thuc
FRONTEND_URL=http://localhost:5173
AUTH_TOKEN_TTL_MINUTES=15
AUTH_RESEND_MIN_SECONDS=60
AUTH_LIMIT_PER_EMAIL_PER_HOUR=5
AUTH_LIMIT_PER_IP_PER_HOUR=20
AUTH_REQUEST_LOG_RETENTION_DAYS=30
AUTH_LINK_LIMIT_PER_EMAIL_PER_HOUR=5
AUTH_LINK_LIMIT_PER_IP_PER_HOUR=20

# Gui email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Xianglingo
SMTP_TIMEOUT_SECONDS=15

# Dang nhap Google OAuth2
GOOGLE_CLIENT_ID=

# AI (OpenAI hoac nha cung cap tuong thich OpenAI API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
