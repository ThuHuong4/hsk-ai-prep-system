# Ket noi MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xianglingo

# Bao mat JWT (JWT_SECRET_KEY va AUTH_EMAIL_HMAC_KEY dai toi thieu 32 byte)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_EMAIL_HMAC_KEY=

# Frontend va gioi han xac thuc
FRONTEND_URL=http://localhost:5173
AUTH_TOKEN_TTL_MINUTES=15
AUTH_RESEND_MIN_SECONDS=60
AUTH_LIMIT_PER_EMAIL_PER_HOUR=5
AUTH_LIMIT_PER_IP_PER_HOUR=20
AUTH_REQUEST_LOG_RETENTION_DAYS=30
AUTH_LINK_LIMIT_PER_EMAIL_PER_HOUR=5
AUTH_LINK_LIMIT_PER_IP_PER_HOUR=20

# Gui email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Xianglingo
SMTP_TIMEOUT_SECONDS=15

# Dang nhap Google OAuth2
GOOGLE_CLIENT_ID=

# AI MIEN PHI (Khuyen nghi: Google Gemini Free Tier qua Google AI Studio hoac Groq Free Tier)
# Lay key Gemini mien phi tai: https://aistudio.google.com/apikey
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Giong doc tieng Trung (TTS) & Tao hinh minh hoa de HSK:
# - Mac dinh MIEN PHI 100%, KHONG CAN API KEY (dung Microsoft Edge Neural TTS 3 giong Nam/Nu/Hoi + Pollinations Flux).
# - Tuy chon: dien HF_API_KEY (lay mien phi tai https://huggingface.co/settings/tokens) de tang toc tao anh FLUX.1-schnell.
TTS_PROVIDER=edge
EDGE_TTS_VOICE_NAM=zh-CN-YunxiNeural
EDGE_TTS_VOICE_NU=zh-CN-XiaoxiaoNeural
EDGE_TTS_VOICE_HOI=zh-CN-YunjianNeural
IMAGE_PROVIDER=pollinations
HF_API_KEY=

# Kiem dinh tu dong (voi Gemini: de trong = tu dong dung chinh OPENAI_MODEL de nhin anh va nghe lai am thanh)
OPENAI_VISION_MODEL=
OPENAI_STT_MODEL=
